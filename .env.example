# Development only. Copy to .env and use a unique random SECRET_KEY.
DATABASE_URL=postgresql+asyncpg://decoy:decoy@localhost:5432/deception_db
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=replace-with-a-random-development-secret-at-least-32-chars
DEPLOYMENT_MODE=development
APP_BASE_URL=http://localhost:3000
CANARY_BASE_URL=http://localhost:8000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-local-demo-password
ADMIN_PASSWORD_HASH=
DEMO_MODE=true
ENABLE_LOCAL_DECOYS=false
CORS_ORIGINS=["http://localhost:3000"]
LLM_PROVIDER=offline
# Leave blank to run deterministic offline analysis.
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-v4-flash
